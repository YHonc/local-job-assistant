{
  "manifest_version": 3,
  "name": "本地职位助手",
  "version": "1.3.0",
  "description": "将多个职位页面排队提取并批量添加到本地职位助手。",
  "minimum_chrome_version": "98",
  "permissions": ["activeTab", "scripting", "storage", "alarms"],
  "host_permissions": ["http://127.0.0.1:8765/*", "http://localhost:8765/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {"service_worker": "background.js"},
  "action": {
    "default_popup": "popup.html",
    "default_title": "导入职位",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
